  "version": "0.1.0",
  "updated": "2026-10-16",
  "spelling_policy": "Model names and nicknames follow Macross Wiki article titles. Japanese forms come from the ja.wikipedia game article's unit list.",
  "conventions": {
   "pilot_suffix": "（X機） = X's personal unit. Render as '(X)' after the model, e.g. 'VF-1J Valkyrie (Hikaru)'. Use the short name the series uses for that pilot (Hikaru, Max, Milia, Roy, Isamu, Guld, Alto, Ozma, Michel, Luca, Klan, Brera...). Provisional: confirm once the UI width is measured.",
   "pack_suffix": "／Xパック装備 = equipped with an X Pack. 'Super Pack', 'Armored Pack', 'Strike Pack', 'FAST Pack', 'Sound Booster', 'Fold Speaker', 'Reactive Armor', 'Ghost Booster', 'Twin Booster'.",
   "kai": "改 after a model number = 'Kai' (e.g. VF-19 Kai). Keep 'Kai' rather than 'Custom' because the series uses it as part of the designation.",
   "unusable": "※使用不可 in the source list means the unit cannot be selected by the player.",
   "generic_suffix": "Generic / rank-and-file unit (一般機) → '(Standard)', e.g. 'VF-25 (Standard)'.",
   "versions": "TV / movie versions → '(TV)' / '(Movie)'; with a pilot: 'VF-1A (Kakizaki, TV)'. Giant form → '(Giant)'."
  },
  "game_source": "https://ja.wikipedia.org/wiki/マクロスエースフロンティア",
  "seeded_from": "Macross Ultimate Frontier glossary (base) + Macross Ace Frontier glossary, merged by tools/glossary_seed.py",
  "game_source_en": "https://macross.fandom.com/wiki/Macross_Ace_Frontier",
  "fields": {
   "af_uses": "How many Ace Frontier text entries (EBOOT, mission scripts, unit lists) contain the Japanese name or one of its ja_aliases. 0 = not in the dumped text; the name can still be heard in voice clips",
   "objects": "Mission objects and props from the AF unit table (EBOOT 0x259044-0x25A7A0). muf_en = how MUF translated the same label, when it did",
   "tf_uses": "How many Triangle Frontier text entries outside the campus mode (EBOOT, menu CSVs, mission scripts, unit lists) contain the Japanese name or a ja_aliases form. 0 = not in the dumped text; it can still be heard in voice clips",
   "tf_campus_uses": "How many campus event script lines contain the name",
   "muf_role": "Role in Macross Ultimate Frontier, kept from the MUF glossary"
  }
 },
